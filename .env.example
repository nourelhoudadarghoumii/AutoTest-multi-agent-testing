# =============================================================================
# AutoTest — Environment Configuration
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Add your OpenRouter API key below
# 3. NEVER commit .env to Git
# =============================================================================

# =============================================================================
# REQUIRED — Test generation will not work without this
# =============================================================================

# OpenRouter API Key
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# API base URL (OpenRouter's OpenAI-compatible endpoint)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# FIXED free models — one per agent. No auto selection, no fallbacks:
#   Test Writer -> OPENROUTER_TEST_WRITER_MODEL
#   Debugger    -> OPENROUTER_DEBUGGER_MODEL
OPENROUTER_TEST_WRITER_MODEL=cohere/north-mini-code:free
OPENROUTER_DEBUGGER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# =============================================================================
# OPTIONAL — Sandbox execution
# =============================================================================

# E2B Sandbox (recommended for untrusted code)
# Get a FREE key at: https://e2b.dev/
# Without this, tests run locally (fine for development).
# E2B_API_KEY=e2b_YOUR_KEY_HERE

# =============================================================================
# OPTIONAL — Observability
# =============================================================================

# LangSmith tracing (LLM call monitoring)
# Get a key at: https://smith.langchain.com/
# LANGSMITH_API_KEY=lsv2_pt_YOUR_KEY_HERE
# LANGSMITH_PROJECT=autotest
# LANGSMITH_TRACING=true

# =============================================================================
# OPTIONAL — System configuration
# =============================================================================

# Upload limits
MAX_UPLOAD_SIZE_MB=100

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# ChromaDB vector database path (RAG bug-pattern memory)
CHROMA_PERSIST_DIR=./chroma_data
